[Unit]
Description=Ziwei Doushu Next.js application
After=network.target
ConditionPathExists=/opt/ziwei-doushu/current/server.js

[Service]
Type=simple
User=ziwei
Group=ziwei
WorkingDirectory=/opt/ziwei-doushu/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3080
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=-/etc/ziwei-doushu.env
ExecStart=/usr/local/bin/node /opt/ziwei-doushu/current/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ziwei-doushu/releases
UMask=0027
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
