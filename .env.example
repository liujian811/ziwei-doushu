# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 上游示例变量仅供参考。本 Fork 已提供 /settings，模型配置通过该页面保存到服务器。
# 排盘不需要 API Key；AI 解读使用 /settings 中的配置。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 自托管无需 Vercel 统计；在 Vercel 上使用时可设为 true。
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# 仅服务端使用，生产环境写入 /etc/ziwei-doushu.env，绝不能使用 NEXT_PUBLIC 前缀。
# 管理员密码至少 16 字符，会话密钥至少 32 字符；请独立随机生成。
ZIWEI_ADMIN_PASSWORD=
ZIWEI_SESSION_SECRET=
ZIWEI_CONFIG_DIR=/var/lib/ziwei-doushu
# 仅复用既有公网 HTTP 模型网关时设为 1；优先使用 HTTPS。
ZIWEI_ALLOW_HTTP_MODEL=0
